<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <desktops><number>1</number></desktops>
  <keyboard>
    <keybind key="A-Tab">
      <action name="NextWindow"><dialog>no</dialog></action>
    </keybind>
    <keybind key="C-A-S-q">
      <action name="Execute"><command>/usr/local/bin/typewriter-power poweroff</command></action>
    </keybind>
  </keyboard>
  <mouse/>
  <applications>
    <application type="normal" class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
