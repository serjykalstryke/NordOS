#!/bin/bash
set -eu
export GTK_THEME=Adwaita:dark
export XDG_CURRENT_DESKTOP=Typewriter
app_args=()
if xrandr --current | grep -Eq "^(eDP|LVDS)[^ ]* connected (primary )?(25[0-9]{2}|28[0-9]{2}|3[0-9]{3})x"; then
    export GDK_SCALE=2
    app_args+=(--force-device-scale-factor=1.75)
fi

xsetroot -solid '#2e3440'
xset s off
xset dpms 0 0 600 || true
openbox --config-file /etc/typewriter/openbox.xml &
manager=$!
trap 'kill "$manager" 2>/dev/null || true' EXIT
if grep -qw 'typewriter.install=1' /proc/cmdline && [[ -x /usr/local/bin/typewriter-installer ]]; then
    while kill -0 "$manager" 2>/dev/null; do
        /usr/local/bin/typewriter-installer || true
        sleep 2
    done
else
    udiskie --automount --no-notify --no-tray &
    while kill -0 "$manager" 2>/dev/null; do
        /usr/local/bin/typewriter-writing-session "${app_args[@]}" || true
        sleep 2
    done
fi
